# Microsoft 계정은 기존 EIS 계정과 별도 UUID·권한·OTP로 관리합니다.
# 기존 Supabase 환경 변수와 REQUIRE_MFA 설정은 그대로 사용합니다.
# MS는 검증된 bcave.co.kr 이메일만 허용하며 EIS OTP를 생략합니다. 기존 EIS OTP는 유지합니다.
# Node.js ^20.19.0 || ^22.12.0 || >=23.0.0 지원, 운영 22.12.0 이상 권장.
# 자동 프로필이 있어도 app_metadata.microsoft_access_approved === true 관리자 승인 필수.
# 이 파일에는 실제 비밀 값을 넣지 않습니다.
NEXT_PUBLIC_BASE_URL=https://portal.bcave.co.kr
NEXT_PUBLIC_MICROSOFT_SSO_ENABLED=false
# 기본 로컬은 localhost:3000 / 127.0.0.1:3000입니다. 다른 포트 사용 시 명시합니다.
NEXT_PUBLIC_AUTH_LOCAL_ORIGINS=http://localhost:3105,http://127.0.0.1:3105
MICROSOFT_TENANT_ID=09cefcf6-a744-4cc2-a8ec-681fe0d1a85a
MICROSOFT_CLIENT_ID=6bda999f-ddc2-4411-bb66-9e5ece2a7bb2
# 과거 자동 연결 공급자 비활성화에 사용할 식별자이며 신규 계정 연결에는 쓰지 않습니다.
MICROSOFT_OIDC_PROVIDER_ID=custom:bcave-entra
# Entra Client Secret의 Value를 .env.local 또는 서버 환경 변수에 직접 입력합니다.
MICROSOFT_CLIENT_SECRET=
